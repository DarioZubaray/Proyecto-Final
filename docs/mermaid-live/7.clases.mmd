    }

    class ServiceLocatorBLL {
        <<static>>
        +GetUserMPP() IUserMPP
        +GetRoleMPP() IRoleMPP
        +CreateAuthBLL() IAuthBLL
        +CreateUserBLL() IUserBLL
        +CreateClassroomBLL() IClassroomBLL
        +CreateCourseBLL() ICourseBLL
    }

    class SessionManagerBLL {
        -Dictionary~int,SessionManagerBLL~ _instances
        +CreateSession(UserBE) SessionManagerBLL
        +GetInstance(int) SessionManagerBLL
        +RemoveSession(int) void

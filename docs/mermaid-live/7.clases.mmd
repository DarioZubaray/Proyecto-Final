    }

    class UserMPP {
        -AccessDAL _access
        +GetByUserName(string) UserBE
        +Save(UserBE) bool
        +Delete(UserBE) bool
    }

    class ClassroomMPP {
        -AccessDAL _access
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
        +FindById(int) ClassroomBE
        +FindAll() List~ClassroomBE~
    }

    class CourseMPP {
        -AccessDAL _access
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
        +FindById(int) CourseBE
        +ExistsClassroomOverlap(...) bool
    }

    class AccessDAL {
        +Read(string, SqlParameters[]) DataTable
        +ReadScalar(string) int
        +Save(string, SqlParameters[]) bool
    }

    class LoginForm {
        +IAuthBLL _authBLL
        +btnLogin_Click(object, EventArgs) void
    }

    class MainForm {
        +SessionManagerBLL _session
        +ShowMenuByPermissions() void
    }


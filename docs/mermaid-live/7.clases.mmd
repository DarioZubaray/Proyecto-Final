classDiagram
    class UserBE {
        +int Id
        +string UserName
        +string PasswordHash
        +bool IsActive
        +int RetriesCount
        +DateTime LastUpdate
        +DateTime CreatedAt
        +string Language
        +string Theme
        +int RoleId
    }

    class LoginResultBE {
        +bool Success
        +string Message
        +UserBE User
        +string ErrorCode
    }

    class RoleBE {
        +int Id
        +string Name
    }

    class PermissionBE {
        +int Id
        +string Name
        +string Label
        +string Description
        +bool IsSystem
    }

    class ClassroomBE {
        +int Id
        +string Name
        +int Capacity
        +bool IsActive
        +DateTime CreatedAt
        +DateTime LastUpdate
    }

    class CourseBE {
        +int Id
        +string Name
        +string Description
        +DateTime StartDate
        +DateTime EndDate
        +int ClassroomId
        +string ClassroomName
        +int? DayOfWeek
        +TimeSpan? StartTime
        +TimeSpan? EndTime
        +bool IsActive
        +List~UserBE~ Teachers
    }

    class EnrollmentBE {
        +int Id
        +int CourseId
        +int StudentId
        +bool IsActive
        +string CourseName
        +string StudentName
    }

    class AttendanceBE {
        +int Id
        +int CourseId
        +int StudentId
        +DateTime Date
        +bool IsPresent
        +string StudentName
        +string CourseName
    }

    class RoleComponentBE {
        <<abstract>>
        +string Name
        +HasPermission(string) bool
        +GetAllPermissions() List~PermissionBE~
    }

    class RoleCompositeBE {
        +List~RoleComponentBE~ _children
        +AddChild(RoleComponentBE) void
        +RemoveChild(RoleComponentBE) void
    }

    class PermissionLeafBE {
        +PermissionBE _permission
    }

    class IActivityLogEntryBE {
        <<interface>>
        +int UserId
        +string Action
        +string FormName
        +string Description
        +bool Execute()
    }

    class ActivityLogEntryBE {
        +int UserId
        +string Action
        +string FormName
        +string Description
        +bool Execute()
    }

    class ActivityLoggingDecoratorBLL {
        -IActivityLogEntryBE _activity
        -IActivityMPP _activityMPP
        +bool Execute()
    }

    class IPasswordStrategyBLL {
        <<interface>>
        +bool Matches(string)
        +string Hash(string)
        +bool Verify(string, string)
    }

    class BcryptPasswordStrategyBLL {
        +bool Matches(string)
        +string Hash(string)
        +bool Verify(string, string)
    }

    class LegacySha256PasswordStrategyBLL {
        +bool Matches(string)
        +string Hash(string)
        +bool Verify(string, string)
    }

    class PasswordHasherBLL {
        +List~IPasswordStrategyBLL~ _strategies
        +string HashPassword(string)
        +bool VerifyPassword(string, string)
    }

    class AuthBLL {
        -IUserMPP _userMPP
        +Login(string, string) LoginResultBE
        +Logout(UserBE) bool
    }

    class UserBLL {
        -IUserMPP _userMPP
        +Save(UserBE) bool
        +Delete(UserBE) bool
        +FindAll() List~UserBE~
        +FindById(int) UserBE
        +ChangePassword(int, string, string) bool
    }

    class RoleBLL {
        -IRoleMPP _roleMPP
        +Save(RoleBE) int
        +Delete(int) bool
        +SavePermissions(int, List~int~) void
    }

    class PermissionBLL {
        -IRoleMPP _roleMPP
        +BuildRoleTree(int) RoleCompositeBE
        +HasPermission(int, string) bool
    }

    class ActivityBLL {
        -IActivityMPP _activityMPP
        +LogFormAccess(int, string, string) void
        +LogLogin(int, string) void
        +LogLogout(int, string) void
        +GetByUserPaginated(int, int, int) List~ActivityLogBE~
    }

    class ClassroomBLL {
        -IClassroomMPP _classroomMPP
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
        +FindById(int) ClassroomBE
        +FindAll() List~ClassroomBE~
        +Count() int
    }

    class CourseBLL {
        -ICourseMPP _courseMPP
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
        +FindById(int) CourseBE
        +FindAll() List~CourseBE~
        +ExistsClassroomOverlap(...) bool
        +SaveTeachers(int, List~int~) bool
    }

    class EnrollmentBLL {
        -IEnrollmentMPP _enrollmentMPP

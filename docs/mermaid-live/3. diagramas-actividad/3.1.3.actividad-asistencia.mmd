flowchart LR
    subgraph PRO[Profesor]
        direction TB
        P1([Inicio])
        P2[Toma la lista en clase]
        P3[Marca presentes y ausentes en el sistema]
        P4[Registra la evaluación y las notas del curso]
        P5([Fin])
    end
    subgraph SIS[Sistema]
        direction TB
        S1[Valida que el curso le pertenezca al Profesor]
        S2[Guarda la planilla de asistencia]
        S3[Guarda la evaluación y las notas 0 a 10]
    end
    subgraph COO[Coordinador]
        direction TB
        C1[Supervisa la asistencia y el rendimiento vía reportes]
    end
    P1 --> P2 --> P3 --> S1
    S1 --> S2 --> P4 --> S3 --> P5
    P5 -.-> C1

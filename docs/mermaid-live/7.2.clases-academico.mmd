classDiagram
    direction TB

    %% ============ BE ============
    class ClassroomBE {
        +int Id
        +string Name
        +int Capacity
        +bool IsActive
        +DateTime CreatedAt
        +DateTime LastUpdate
    }

    class CourseBE {
        +int Id
        +string Name
        +string Description
        +DateTime StartDate
        +DateTime EndDate
        +int ClassroomId
        +string ClassroomName
        +int? DayOfWeek
        +TimeSpan? StartTime
        +TimeSpan? EndTime
        +bool IsActive
        +List~UserBE~ Teachers
    }

    class EnrollmentBE {
        +int Id
        +int CourseId
        +int StudentId
        +bool IsActive
        +string CourseName
        +string StudentName
    }

    class AttendanceBE {
        +int Id
        +int CourseId
        +int StudentId
        +DateTime Date
        +bool IsPresent
        +string StudentName
        +string CourseName
    }

    %% ============ BLL - Interfaces ============
    class IClassroomBLL {
        <<interface>>
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
        +FindAll() List~ClassroomBE~
    }

    class ICourseBLL {
        <<interface>>
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
        +FindAll() List~CourseBE~
    }

    class IEnrollmentBLL {
        <<interface>>
        +Enroll(int, int) bool
        +Unenroll(int, int) bool
    }

    class IAttendanceBLL {
        <<interface>>
        +RegisterAttendanceBulk(int, DateTime, List~AttendanceBE~) bool
    }

    %% ============ BLL - Servicios ============
    class ClassroomBLL {
        -IClassroomMPP _classroomMPP
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
        +FindById(int) ClassroomBE
        +FindAll() List~ClassroomBE~
        +Count() int
    }

    class CourseBLL {
        -ICourseMPP _courseMPP
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
        +FindById(int) CourseBE
        +FindAll() List~CourseBE~
        +ExistsClassroomOverlap(...) bool
        +SaveTeachers(int, List~int~) bool
    }

    class EnrollmentBLL {
        -IEnrollmentMPP _enrollmentMPP
        -ICourseBLL _courseBLL
        +Enroll(int, int) bool
        +Unenroll(int, int) bool
        +FindByStudentId(int) List~EnrollmentBE~
    }

    class AttendanceBLL {
        -IAttendanceMPP _attendanceMPP
        +RegisterAttendanceBulk(int, DateTime, List~AttendanceBE~) bool
        +FindByCourseIdAndDate(int, DateTime) List~AttendanceBE~
        +IsTeacherOfCourse(int, int) bool
    }

    %% ============ MPP ============
    class IClassroomMPP {
        <<interface>>
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
    }

    class ICourseMPP {
        <<interface>>
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
    }

    class IEnrollmentMPP {
        <<interface>>
        +Enroll(int, int) bool
        +Unenroll(int, int) bool
    }

    class IAttendanceMPP {
        <<interface>>
        +SaveBulk(int, DateTime, List~AttendanceBE~) bool
    }

    class ClassroomMPP {
        -AccessDAL _access
        +Save(ClassroomBE) bool
        +Delete(ClassroomBE) bool
        +FindById(int) ClassroomBE
        +FindAll() List~ClassroomBE~
    }

    class CourseMPP {
        -AccessDAL _access
        +Save(CourseBE) bool
        +Delete(CourseBE) bool
        +FindById(int) CourseBE
        +FindAll() List~CourseBE~
        +ExistsClassroomOverlap(...) bool
    }

    class EnrollmentMPP {
        -AccessDAL _access
        +Enroll(int, int) bool
        +Unenroll(int, int) bool
        +ExistsActiveEnrollment(int, int) bool
        +FindByStudentId(int) List~EnrollmentBE~
    }

    class AttendanceMPP {
        -AccessDAL _access
        +SaveBulk(int, DateTime, List~AttendanceBE~) bool
        +FindByCourseIdAndDate(int, DateTime) List~AttendanceBE~
    }

    %% ============ DAL (compartido) ============
    class AccessDAL {
        +Read(string, SqlParameter[]) DataTable
        +ReadScalar(string, SqlParameter[]) int
        +Save(string, SqlParameter[]) bool
        +Execute(string, SqlParameter[]) bool
    }

    %% ============ GUI ============
    class ClassroomManagementForm {
        +IClassroomBLL _classroomBLL
        +LoadClassrooms() void
    }

    class ClassroomForm {
        +ClassroomBE _classroom
        +btnSave_Click(object, EventArgs) void
    }

    class CourseManagementForm {
        +ICourseBLL _courseBLL
        +LoadCourses() void
    }

    class CourseForm {
        +CourseBE _course
        +btnSave_Click(object, EventArgs) void
    }

    class EnrollmentForm {
        +IEnrollmentBLL _enrollmentBLL
        +ICourseBLL _courseBLL
        +btnEnroll_Click(object, EventArgs) void
    }

    class EnrollmentManagementForm {
        +IEnrollmentBLL _enrollmentBLL
        +LoadEnrollments() void
    }

    class AttendanceForm {
        +IAttendanceBLL _attendanceBLL
        +btnSaveAttendance_Click(object, EventArgs) void
    }

    class AttendanceViewForm {
        +IAttendanceBLL _attendanceBLL
        +LoadAttendance() void
    }

    %% ============ Relaciones ============
    CourseBE --> ClassroomBE : classroom
    EnrollmentBE --> CourseBE : course
    AttendanceBE --> CourseBE : course

    ClassroomBLL ..|> IClassroomBLL
    CourseBLL ..|> ICourseBLL
    EnrollmentBLL ..|> IEnrollmentBLL
    AttendanceBLL ..|> IAttendanceBLL
    ClassroomMPP ..|> IClassroomMPP
    CourseMPP ..|> ICourseMPP
    EnrollmentMPP ..|> IEnrollmentMPP
    AttendanceMPP ..|> IAttendanceMPP

    ClassroomBLL --> ClassroomMPP : _classroomMPP
    CourseBLL --> CourseMPP : _courseMPP
    EnrollmentBLL --> EnrollmentMPP : _enrollmentMPP
    EnrollmentBLL --> CourseBLL : _courseBLL
    AttendanceBLL --> AttendanceMPP : _attendanceMPP
    ClassroomMPP --> AccessDAL : _access
    CourseMPP --> AccessDAL : _access
    EnrollmentMPP --> AccessDAL : _access
    AttendanceMPP --> AccessDAL : _access

    ClassroomManagementForm --> IClassroomBLL : _classroomBLL
    CourseManagementForm --> ICourseBLL : _courseBLL
    EnrollmentForm --> IEnrollmentBLL : _enrollmentBLL
    EnrollmentManagementForm --> IEnrollmentBLL : _enrollmentBLL
    AttendanceForm --> IAttendanceBLL : _attendanceBLL
    AttendanceViewForm --> IAttendanceBLL : _attendanceBLL

classDiagram
    class UserBE {
        +DateTime CreatedAt
        +int Id
        +bool IsActive
        +string Language
        +DateTime LastUpdate
        +string PasswordHash
        +int RetriesCount
        +RoleBE Role
        +int RoleId
        +string Theme
        +string UserName
    }

    class LoginResult {
        +string Message
        +bool Success
        +UserBE User
    }

    class RoleBE {
        +int Id
        +string Name
    }

    class IUserMPP {
        <<interface>>
        +Deactivate(int) bool
        +GetByUserName(string) UserBE
        +Save(UserBE) bool
        +UpdateRetries(int, int) bool
    }

    class AuthBLL {
        +IUserMPP _userMPP
        -AreCredentialsNotEmptyOrNull(string, string) bool
        -AuthenticateUser(UserBE, string) LoginResultBE
        -CreateLoginFailed(string, string) LoginResultBE
        +Login(string, string) LoginResultBE
        -LoginFailed(UserBE) LoginResultBE
        -LoginSuccessful(UserBE) LoginResultBE
        +Logout(UserBE) bool
    }

    class EncryptionBLL {
        +HashPassword(string) string
        +VerifyPassword(string, string) bool
    }

    class UserMPP {
        +AccessDAL _dal
        +Deactivate(int) bool
        -FindOne(string, SqlParameters[]) UserBE
        +GetByUserName(string) UserBE
        -MapUser(DataRow) UserBE
        +Save(UserBE) bool
        +UpdateRetries(int, int) bool
    }

    class AccessDAL {
        +string _connectionString
        +Read(string, SqlParameters[]) DataTable
        +Save(string, SqlParameters[]) DataTable
    }

    class LoginForm {
        +IAuthBLL _authBLL
        +btnLogin_Click(object, EventArgs) void
    }

    class ErrorFormatter {
        +WithCode(string, string) string
    }

    UserBE --> RoleBE : role
    AuthBLL --> IUserMPP : _userMPP
    AuthBLL --> EncryptionBLL : uses
    UserMPP ..|> IUserMPP : implements
    UserMPP --> AccessDAL : _dal
    LoginForm --> AuthBLL : _authBLL
    LoginForm --> ErrorFormatter : <<use>>
    LoginResult --> UserBE : User

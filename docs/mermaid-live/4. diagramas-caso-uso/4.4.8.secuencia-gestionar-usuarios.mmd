sequenceDiagram
    autonumber
    actor Administrador
    participant GUI as GUI
    participant BE as BE
    participant BLL as BLL
    participant MPP as MPP
    participant DAL as DAL
    participant BD as Base de Datos

    Note right of BE: UserBE y RoleBE transportan los datos entre capas
    Note over Administrador,BD: CU-04 Gestionar Usuarios - flujos básicos

    Administrador->>GUI: Elige "Usuarios" en el menú "Administración"
    GUI->>BLL: FindAll(): List<UserBE>
    BLL->>MPP: FindAll(): List<UserBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada de usuarios
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Administrador: Muestra la ventana "Gestión de Usuarios" con la grilla

    Administrador->>GUI: Presiona el botón "Nuevo"
    GUI->>BLL: FindAll(): List<RoleBE>
    BLL->>MPP: FindAll(): List<RoleBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada de roles
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<RoleBE>
    BLL-->>GUI: List<RoleBE>
    GUI-->>Administrador: Muestra el formulario "Nuevo Usuario" con los campos y la lista de roles

    Administrador->>GUI: Completa "Nombre de usuario", "Contraseña" y selecciona "Rol"
    Administrador->>GUI: Presiona el botón "Guardar"
    GUI->>BLL: Save(user: UserBE): bool
    BLL->>MPP: Save(user: UserBE): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro del usuario
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL->>MPP: UpdateDvh(userId: int, dvh: string): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro del dígito verificador (DVH)
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL-->>GUI: true
    GUI-->>Administrador: Muestra "Usuario guardado correctamente." y cierra el formulario
    GUI->>BLL: FindAll(): List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Administrador: Vuelve a la grilla con el usuario nuevo incluido

    Administrador->>GUI: Selecciona un usuario y presiona "Editar"
    GUI-->>Administrador: Muestra el formulario "Editar Usuario" con los datos cargados
    Administrador->>GUI: Modifica los campos y presiona "Guardar"
    GUI->>BLL: Save(user: UserBE): bool
    BLL->>MPP: Save(user: UserBE): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Actualización del usuario
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL->>MPP: UpdateDvh(userId: int, dvh: string): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro del dígito verificador (DVH)
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL-->>GUI: true
    GUI-->>Administrador: Muestra "Usuario guardado correctamente." y cierra el formulario
    GUI->>BLL: FindAll(): List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Administrador: Vuelve a la grilla con los datos actualizados

    Administrador->>GUI: Selecciona un usuario y presiona "Eliminar"
    GUI-->>Administrador: Muestra la confirmación "¿Está seguro que desea eliminar el usuario?"
    Administrador->>GUI: Presiona "Sí"
    GUI->>BLL: Delete(user: UserBE): bool
    BLL->>MPP: Delete(user: UserBE): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Baja lógica del usuario (is_active = 0)
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL->>MPP: FindById(user: UserBE): UserBE
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta del usuario por id
    BD-->>DAL: Fila resultante
    DAL-->>MPP: DataTable
    MPP-->>BLL: UserBE
    BLL->>MPP: UpdateDvh(userId: int, dvh: string): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro del dígito verificador (DVH)
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL-->>GUI: true
    GUI-->>Administrador: Muestra "Usuario eliminado correctamente."
    GUI->>BLL: FindAll(): List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Administrador: Actualiza la grilla

    Administrador->>GUI: Completa el campo de búsqueda y presiona "Buscar"
    GUI->>BLL: FindByUserName(userName: string): List<UserBE>
    BLL->>MPP: FindByUserName(userName: string): List<UserBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada por nombre parcial
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Administrador: Muestra en la grilla los usuarios coincidentes
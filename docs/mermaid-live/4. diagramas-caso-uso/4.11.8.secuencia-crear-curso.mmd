sequenceDiagram
    autonumber
    actor Coordinador
    participant frm as frm : CourseForm
    participant classroomBLL as classroomBLL : ClassroomBLL
    participant classroomMPP as classroomMPP : ClassroomMPP
    participant userBLL as userBLL : UserBLL
    participant userMPP as userMPP : UserMPP
    participant courseBLL as courseBLL : CourseBLL
    participant courseMPP as courseMPP : CourseMPP
    participant dal as dal : AccessDAL
    participant bd as Base de Datos

    Note over Coordinador,bd: CU-11 Crear Curso - flujo básico (pasos 1 a 15)

    Coordinador->>frm: Accede a "Cursos" del menú "Administración" y presiona "Nuevo"
    frm->>frm: _courseBLL = ServiceLocatorBLL.CreateCourseBLL()
    frm->>frm: _classroomBLL = ServiceLocatorBLL.CreateClassroomBLL()
    frm->>frm: _userBLL = ServiceLocatorBLL.CreateUserBLL()
    create participant course as course : CourseBE
    frm->>course: new CourseBE()
    frm->>classroomBLL: FindAll(): List<ClassroomBE>
    classroomBLL->>classroomMPP: FindAll(): List<ClassroomBE>
    classroomMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de aulas
    bd-->>dal: Filas resultantes
    dal-->>classroomMPP: DataTable
    classroomMPP-->>classroomBLL: List<ClassroomBE>
    classroomBLL-->>frm: List<ClassroomBE>
    frm->>userBLL: FindAll(): List<UserBE>
    userBLL->>userMPP: FindAll(): List<UserBE>
    userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de usuarios
    bd-->>dal: Filas resultantes
    dal-->>userMPP: DataTable
    userMPP-->>userBLL: List<UserBE>
    userBLL-->>frm: List<UserBE>
    frm-->>Coordinador: Muestra el formulario de alta con los campos y las listas

    Coordinador->>frm: Completa el campo "Nombre"
    Coordinador->>frm: Completa el campo "Descripción"
    Coordinador->>frm: Completa el campo "Fecha de inicio"
    Coordinador->>frm: Completa el campo "Fecha de fin"
    Coordinador->>frm: Selecciona el campo "Aula"
    Coordinador->>frm: Completa el campo "Hora de inicio"
    Coordinador->>frm: Completa el campo "Hora de fin"
    Coordinador->>frm: Selecciona un docente de la lista "Docentes disponibles" y presiona el botón "Agregar"
    frm-->>Coordinador: Muestra el docente en la lista "Docentes asignados"
    Coordinador->>frm: Presiona el botón "Guardar"

    frm->>courseBLL: ValidateTeacherOverlap(courseId: int, dayOfWeek: int?, startTime: TimeSpan?, endTime: TimeSpan?, teacherIds: List<int>): bool
    courseBLL->>courseMPP: ExistsTeacherOverlap(teacherId: int, dayOfWeek: int, startTime: TimeSpan, endTime: TimeSpan, courseIdToExclude: int): bool
    courseMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta de traslape del docente
    bd-->>dal: Filas resultantes
    dal-->>courseMPP: DataTable
    courseMPP-->>courseBLL: false
    courseBLL-->>frm: false

    frm->>courseBLL: Save(course: CourseBE): bool
    courseBLL->>courseMPP: ExistsClassroomOverlap(classroomId: int, startDate: DateTime, endDate: DateTime, courseIdToExclude: int, dayOfWeek: int?, startTime: TimeSpan?, endTime: TimeSpan?): bool
    courseMPP->>dal: ReadScalar(consulta: string, parameters: SqlParameter[]): int
    dal->>bd: Consulta de traslape del aula
    bd-->>dal: Cantidad de coincidencias
    dal-->>courseMPP: int
    courseMPP-->>courseBLL: false
    courseBLL->>courseMPP: Save(course: CourseBE): bool
    courseMPP->>dal: ReadScalar(consulta: string, parameters: SqlParameter[]): int
    dal->>bd: Alta del curso con retorno de identidad (SCOPE_IDENTITY)
    bd-->>dal: Identidad de la fila
    dal-->>courseMPP: int
    courseMPP-->>courseBLL: true
    courseBLL-->>frm: true

    frm->>courseBLL: SaveTeachers(courseId: int, teacherIds: List<int>): bool
    courseBLL->>courseMPP: SaveTeachers(courseId: int, teacherIds: List<int>): bool
    courseMPP->>dal: Save(operacion: string, parameters: SqlParameter[]): bool
    dal->>bd: Registro de la asignación de docentes
    bd-->>dal: 1 fila afectada
    dal-->>courseMPP: true
    courseMPP-->>courseBLL: true
    courseBLL-->>frm: true
    frm-->>Coordinador: Muestra "Curso creado exitosamente." y cierra el formulario

sequenceDiagram
    autonumber
    actor Usuario
    participant GUI as GUI
    participant BE as BE
    participant BLL as BLL
    participant MPP as MPP
    participant DAL as DAL
    participant BD as Base de Datos

    Note right of BE: CourseBE, ClassroomBE y UserBE transportan los datos entre capas
    Note over Usuario,BD: CU-11 Crear Curso - flujo básico (pasos 1 a 15)

    Usuario->>GUI: Accede a "Cursos" y presiona "Nuevo"
    GUI->>BLL: FindAll(): List<ClassroomBE>
    BLL->>MPP: FindAll(): List<ClassroomBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada de aulas
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<ClassroomBE>
    BLL-->>GUI: List<ClassroomBE>
    GUI->>BLL: FindAll(): List<UserBE>
    BLL->>MPP: FindAll(): List<UserBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada de usuarios
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<UserBE>
    BLL-->>GUI: List<UserBE>
    GUI-->>Usuario: Muestra el formulario de alta con los campos y las listas

    Usuario->>GUI: Completa "Nombre", "Descripción", "Fecha de inicio", "Fecha de fin", "Aula", "Hora de inicio" y "Hora de fin"
    Usuario->>GUI: Selecciona un docente y presiona "Agregar"
    GUI-->>Usuario: Muestra el docente en la lista "Docentes asignados"
    Usuario->>GUI: Presiona "Guardar"

    GUI->>BLL: ValidateTeacherOverlap(courseId: int, dayOfWeek: int?, startTime: TimeSpan?, endTime: TimeSpan?, teacherIds: List<int>): bool
    BLL->>MPP: ExistsTeacherOverlap(teacherId: int, dayOfWeek: int, startTime: TimeSpan, endTime: TimeSpan, courseIdToExclude: int): bool
    MPP->>DAL: ReadScalar(consulta: string, parameters: SqlParameter[]): int
    DAL->>BD: Consulta de traslape del docente
    BD-->>DAL: Cantidad de coincidencias
    DAL-->>MPP: int
    MPP-->>BLL: false
    BLL-->>GUI: false

    GUI->>BLL: Save(course: CourseBE): bool
    BLL->>MPP: ExistsClassroomOverlap(classroomId: int, startDate: DateTime, endDate: DateTime, courseIdToExclude: int, dayOfWeek: int?, startTime: TimeSpan?, endTime: TimeSpan?): bool
    MPP->>DAL: ReadScalar(consulta: string, parameters: SqlParameter[]): int
    DAL->>BD: Consulta de traslape del aula
    BD-->>DAL: Cantidad de coincidencias
    DAL-->>MPP: int
    MPP-->>BLL: false
    BLL->>MPP: Save(course: CourseBE): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro del curso
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL-->>GUI: true

    GUI->>BLL: SaveTeachers(courseId: int, teacherIds: List<int>): bool
    BLL->>MPP: SaveTeachers(courseId: int, teacherIds: List<int>): bool
    MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
    DAL->>BD: Registro de la asignación de docentes
    BD-->>DAL: 1 fila afectada
    DAL-->>MPP: true
    MPP-->>BLL: true
    BLL-->>GUI: true
    GUI-->>Usuario: Muestra "Curso creado exitosamente." y cierra el formulario

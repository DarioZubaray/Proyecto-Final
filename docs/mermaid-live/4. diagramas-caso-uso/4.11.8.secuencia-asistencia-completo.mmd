sequenceDiagram
    autonumber
    actor Profesor
    participant GUI as GUI
    participant BE as BE
    participant BLL as BLL
    participant MPP as MPP
    participant DAL as DAL
    participant BD as Base de Datos

    Note right of BE: CourseBE, EnrollmentBE y AttendanceBE transportan los datos entre las capas
    Note over Profesor,BD: CU-11 Registrar Asistencia - flujo básico y flujos alternativos

    Profesor->>GUI: Accede al formulario "Registrar Asistencia"
    GUI->>BLL: FindByTeacherId(teacherId: int): List<CourseBE>
    BLL->>MPP: FindByTeacherId(teacherId: int): List<CourseBE>
    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
    DAL->>BD: Consulta parametrizada de cursos del docente
    BD-->>DAL: Filas resultantes
    DAL-->>MPP: DataTable
    MPP-->>BLL: List<CourseBE>
    BLL-->>GUI: List<CourseBE>

    alt El Profesor no tiene cursos asignados
        GUI-->>Profesor: Muestra "No tiene cursos asignados." y deshabilita "Buscar" y "Guardar Asistencia"
    else Tiene cursos asignados
        GUI-->>Profesor: Muestra sus cursos, el campo "Fecha" y habilita "Buscar" y "Guardar Asistencia"
        Profesor->>GUI: Selecciona "Curso" y "Fecha" y presiona "Buscar"

        alt Curso no seleccionado
            GUI-->>Profesor: Muestra "Debe seleccionar un curso."
        else Curso seleccionado
            GUI->>BLL: IsTeacherOfCourse(courseId: int, teacherId: int): bool
            BLL->>MPP: IsTeacherOfCourse(courseId: int, teacherId: int): bool
            MPP->>DAL: ReadScalar(consulta: string, parameters: SqlParameter[]): int
            DAL->>BD: Consulta de pertenencia del curso
            BD-->>DAL: Cantidad de coincidencias
            DAL-->>MPP: int
            MPP-->>BLL: true
            BLL-->>GUI: true

            alt El curso no le pertenece al Profesor
                BLL-->>GUI: false
                GUI-->>Profesor: Muestra "No tiene permiso para registrar asistencia en este curso."
            else Curso asignado al Profesor
                GUI->>BLL: FindAll(): List<EnrollmentBE>
                BLL->>MPP: FindAll(): List<EnrollmentBE>
                MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
                DAL->>BD: Consulta parametrizada de inscripciones
                BD-->>DAL: Filas resultantes
                DAL-->>MPP: DataTable
                MPP-->>BLL: List<EnrollmentBE>
                BLL-->>GUI: List<EnrollmentBE>

                alt Curso sin alumnos inscriptos
                    GUI-->>Profesor: Muestra "No hay alumnos inscritos en este curso."
                else Con alumnos inscriptos
                    GUI->>BLL: FindByCourseIdAndDate(courseId: int, date: DateTime): List<AttendanceBE>
                    BLL->>MPP: FindByCourseIdAndDate(courseId: int, date: DateTime): List<AttendanceBE>
                    MPP->>DAL: Read(consulta: string, parameters: SqlParameter[]): DataTable
                    DAL->>BD: Consulta parametrizada de asistencias
                    BD-->>DAL: Filas resultantes
                    DAL-->>MPP: DataTable
                    MPP-->>BLL: List<AttendanceBE>
                    BLL-->>GUI: List<AttendanceBE>
                    GUI-->>Profesor: Muestra la grilla de alumnos con la asistencia previa de esa fecha

                    Profesor->>GUI: Marca o desmarca la casilla "Presente" de cada alumno y presiona "Guardar Asistencia"

                    alt Grilla vacía
                        GUI-->>Profesor: Muestra "No hay alumnos inscritos en este curso." o "Debe seleccionar un curso."
                    else Grilla con alumnos
                        GUI->>BLL: IsTeacherOfCourse(courseId: int, teacherId: int): bool
                        BLL->>MPP: IsTeacherOfCourse(courseId: int, teacherId: int): bool
                        MPP->>DAL: ReadScalar(consulta: string, parameters: SqlParameter[]): int
                        DAL->>BD: Consulta de pertenencia del curso
                        BD-->>DAL: Cantidad de coincidencias
                        DAL-->>MPP: int
                        MPP-->>BLL: true
                        BLL-->>GUI: true

                        alt El curso no le pertenece al Profesor
                            BLL-->>GUI: false
                            GUI-->>Profesor: Muestra "No tiene permiso para registrar asistencia en este curso."
                        else Curso asignado al Profesor
                            alt La base de datos rechaza la operación
                                BLL-->>GUI: Excepción de SQL Server
                                GUI-->>Profesor: Muestra "Error al guardar la asistencia: <detalle>"
                            else Operación correcta
                                GUI->>BLL: RegisterAttendanceBulk(courseId: int, date: DateTime, records: List<AttendanceBE>): bool
                                BLL->>MPP: RegisterAttendanceBulk(courseId: int, date: DateTime, records: List<AttendanceBE>): bool
                                MPP->>DAL: Save(operacion: string, parameters: SqlParameter[]): bool
                                DAL->>BD: Registro de asistencia por alumno
                                BD-->>DAL: 1 fila afectada
                                DAL-->>MPP: true
                                MPP-->>BLL: true
                                BLL-->>GUI: true
                                GUI-->>Profesor: Muestra "Asistencia guardada exitosamente."
                            end
                        end
                    end
                end
            end
        end
    end

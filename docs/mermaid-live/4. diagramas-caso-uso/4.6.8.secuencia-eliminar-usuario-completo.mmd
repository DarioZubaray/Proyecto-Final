sequenceDiagram
    autonumber
    actor Administrador
    participant frm as frm : UserManagementForm
    participant user as user : UserBE
    participant userBLL as userBLL : UserBLL
    participant userMPP as userMPP : UserMPP
    participant dal as dal : AccessDAL
    participant bd as Base de Datos

    Note over Administrador,bd: CU-06 Eliminar Usuario - flujo básico y flujos alternativos

    Administrador->>frm: Elige "Usuarios" en el menú "Administración"
    frm->>frm: _userBLL = ServiceLocatorBLL.CreateUserBLL()
    frm->>userBLL: FindAll(): List<UserBE>
    userBLL->>userMPP: FindAll(): List<UserBE>
    userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de usuarios
    bd-->>dal: Filas resultantes
    dal-->>userMPP: DataTable
    userMPP-->>userBLL: List<UserBE>
    userBLL-->>frm: List<UserBE>
    frm-->>Administrador: Muestra la ventana "Gestión de Usuarios" con la grilla

    Administrador->>frm: Completa el campo de búsqueda "Nombre de usuario:" y presiona "Buscar"
    alt Texto de búsqueda vacío
        frm->>userBLL: FindAll(): List<UserBE>
        userBLL->>userMPP: FindAll(): List<UserBE>
        userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
        dal->>bd: Consulta parametrizada de usuarios
        bd-->>dal: Filas resultantes
        dal-->>userMPP: DataTable
        userMPP-->>userBLL: List<UserBE>
        userBLL-->>frm: List<UserBE>
        frm-->>Administrador: Muestra la grilla completa de usuarios
    else Texto de búsqueda informado
        frm->>userBLL: FindByUserName(userName: string): List<UserBE>
        userBLL->>userMPP: FindByUserName(userName: string): List<UserBE>
        userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
        dal->>bd: Consulta parametrizada por nombre parcial
        bd-->>dal: Filas resultantes
        dal-->>userMPP: DataTable
        userMPP-->>userBLL: List<UserBE>
        userBLL-->>frm: List<UserBE>
        frm-->>Administrador: Muestra en la grilla los usuarios que coinciden con lo buscado
    end

    Administrador->>frm: Presiona el botón "Eliminar" sin seleccionar un usuario
    alt Ningún usuario seleccionado
        frm-->>Administrador: Muestra "Seleccione un usuario de la grilla. (Código: VAL-005)"
    else Usuario seleccionado
        Administrador->>frm: Selecciona un usuario de la grilla y presiona "Eliminar"
        alt El usuario seleccionado es el usuario admin
            frm-->>Administrador: Muestra "El usuario administrador no puede ser eliminado. (Código: BIZ-005)"
        else Usuario no protegido
            frm-->>Administrador: Muestra la confirmación "¿Está seguro que desea eliminar el usuario "jperez"?"
            alt El usuario presiona "No" en la confirmación
                frm-->>Administrador: No realiza ningún cambio y mantiene la grilla sin modificar
            else El usuario presiona "Sí"
                frm->>userBLL: Delete(user: UserBE): bool
                userBLL->>userMPP: Delete(user: UserBE): bool
                userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                dal->>bd: Consulta del usuario por id
                bd-->>dal: Fila resultante
                dal-->>userMPP: DataTable
                userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                dal->>bd: Baja lógica del usuario con retorno de la fila
                bd-->>dal: Filas resultantes
                dal-->>userMPP: DataTable
                userMPP-->>userBLL: true
                userBLL->>userMPP: FindById(user: UserBE): UserBE
                userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                dal->>bd: Consulta del usuario por id
                bd-->>dal: Fila resultante
                dal-->>userMPP: DataTable
                userMPP-->>userBLL: UserBE
                userBLL->>userMPP: UpdateDvh(userId: int, dvh: string): bool
                userMPP->>dal: Save(operacion: string, parameters: SqlParameter[]): bool
                dal->>bd: Registro del dígito verificador (DVH)
                bd-->>dal: 1 fila afectada
                dal-->>userMPP: true
                userMPP-->>userBLL: true
                userBLL-->>frm: true
                frm-->>Administrador: Muestra "Usuario eliminado correctamente."
                frm->>userBLL: FindAll(): List<UserBE>
                userBLL->>userMPP: FindAll(): List<UserBE>
                userMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                dal->>bd: Consulta parametrizada de usuarios
                bd-->>dal: Filas resultantes
                dal-->>userMPP: DataTable
                userMPP-->>userBLL: List<UserBE>
                userBLL-->>frm: List<UserBE>
                frm-->>Administrador: Actualiza la grilla con el usuario dado de baja
            end
        end
    end

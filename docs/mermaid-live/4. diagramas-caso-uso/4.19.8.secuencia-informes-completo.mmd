sequenceDiagram
    autonumber
    actor Director
    participant frm as frm : ReportForm
    participant courseBLL as courseBLL : CourseBLL
    participant courseMPP as courseMPP : CourseMPP
    participant reportBLL as reportBLL : ReportBLL
    participant reportMPP as reportMPP : ReportMPP
    participant dal as dal : AccessDAL
    participant bd as Base de Datos

    Note over Director,bd: CU-19 Consultar Informe Personalizado - flujos básicos y alternativos

    Director->>frm: Elige "Informes Personalizados" en el menú "Reportes"
    frm->>frm: _courseBLL = ServiceLocatorBLL.CreateCourseBLL()
    frm->>frm: _reportBLL = ServiceLocatorBLL.CreateReportBLL()
    frm->>courseBLL: FindAll(): List<CourseBE>
    courseBLL->>courseMPP: FindAll(): List<CourseBE>
    courseMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de cursos
    bd-->>dal: Filas resultantes
    dal-->>courseMPP: DataTable
    courseMPP-->>courseBLL: List<CourseBE>
    courseBLL-->>frm: List<CourseBE>
    frm-->>Director: Muestra el formulario "Informes Personalizados" con la lista de tipos, la lista de cursos y los botones "Generar" y "Exportar"

    Director->>frm: Selecciona el campo "Tipo de informe"
    Director->>frm: Selecciona el campo "Curso"
    Director->>frm: Presiona el botón "Generar"
    alt Tipo de informe sin seleccionar
        frm->>frm: ValidateInputs(): bool
        frm-->>Director: Muestra "Seleccione el tipo de informe. (Código: VAL-005)"
    else Curso sin seleccionado
        frm->>frm: ValidateInputs(): bool
        frm-->>Director: Muestra "Seleccione un curso de la lista. (Código: VAL-005)"
    else Tipo y curso seleccionados
        alt Tipo de informe = Asistencia por curso
            frm->>reportBLL: GetAttendanceReport(courseId: int): List<AttendanceReportLineBE>
            reportBLL->>reportMPP: GetAttendanceReport(courseId: int): List<AttendanceReportLineBE>
            reportMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
            dal->>bd: Consulta que cruza inscripciones y asistencia del curso
            bd-->>dal: Filas resultantes
            dal-->>reportMPP: DataTable
            reportMPP-->>reportBLL: List<AttendanceReportLineBE>
            reportBLL-->>frm: List<AttendanceReportLineBE>
        else Tipo de informe = Notas por curso
            frm->>reportBLL: GetGradesReport(courseId: int): List<GradeReportLineBE>
            reportBLL->>reportMPP: GetGradesReport(courseId: int): List<GradeReportLineBE>
            reportMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
            dal->>bd: Consulta que cruza inscripciones, evaluaciones y notas del curso
            bd-->>dal: Filas resultantes
            dal-->>reportMPP: DataTable
            reportMPP-->>reportBLL: List<GradeReportLineBE>
            reportBLL-->>frm: List<GradeReportLineBE>
        end
        alt El curso no tiene datos para el tipo de informe seleccionado
            frm-->>Director: Muestra "No hay datos para los criterios seleccionados."
        else Hay datos
            frm-->>Director: Muestra la grilla con el informe del tipo y el curso seleccionados
        end
    end

    Director->>frm: Presiona el botón "Exportar"
    alt Exportar sin informe generado
        frm->>frm: ExportReport()
        frm-->>Director: Muestra "Genere el informe antes de exportarlo."
    else Hay informe generado
        frm-->>Director: Muestra el diálogo "Guardar como" en formato CSV
        alt El usuario cancela el diálogo "Guardar como"
            frm-->>Director: No exporta ningún archivo y mantiene el informe en pantalla
        else El usuario confirma el nombre y la ubicación del archivo
            frm-->>Director: Muestra "Informe exportado correctamente."
        end
    end

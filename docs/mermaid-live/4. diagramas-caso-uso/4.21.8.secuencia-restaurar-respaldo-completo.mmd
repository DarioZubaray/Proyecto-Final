sequenceDiagram
    autonumber
    actor Usuario
    participant GUI as GUI
    participant BLL as BLL
    participant MPP as MPP
    participant DAL as DAL
    participant BD as Base de Datos

    Note over Usuario,BD: CU-21 Restaurar Respaldo - flujo básico y alternativos

    Usuario->>GUI: Elige "Respaldo y Restauración" en el menú "Administración"
    GUI-->>Usuario: Muestra el formulario con "Generar respaldo" y "Restaurar respaldo"

    Usuario->>GUI: Presiona "Restaurar respaldo"
    alt El usuario cancela el diálogo "Abrir"
        Note over GUI: No se restaura nada
    else El usuario selecciona un archivo .bak
        GUI->>BLL: RestoreBackup(filePath: string): bool
        BLL->>MPP: RestoreBackup(filePath: string): bool
        MPP->>DAL: Save(consulta: string, parameters: SqlParameter[]): bool
        DAL->>BD: Excluye conexiones y ejecuta RESTORE DATABASE ... WITH REPLACE
        alt La operación falla
            BD-->>DAL: Error de SQL Server
            DAL-->>MPP: Excepción
            MPP-->>BLL: Excepción
            BLL-->>GUI: Excepción
            GUI-->>Usuario: Muestra "Error al restaurar el respaldo: <detalle>"
        else La operación termina bien
            BD-->>DAL: Confirmación de la operación
            DAL-->>MPP: true
            MPP-->>BLL: true
            BLL-->>GUI: true
            GUI-->>Usuario: Muestra "Respaldo restaurado correctamente."
        end
    end

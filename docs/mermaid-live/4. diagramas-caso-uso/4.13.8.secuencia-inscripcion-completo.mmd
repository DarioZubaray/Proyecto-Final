sequenceDiagram
    autonumber
    actor Coordinador
    participant frm as frm : EnrollmentManagementForm
    participant studentBLL as studentBLL : StudentBLL
    participant studentMPP as studentMPP : StudentMPP
    participant enrollmentBLL as enrollmentBLL : EnrollmentBLL
    participant enrollmentMPP as enrollmentMPP : EnrollmentMPP
    participant courseBLL as courseBLL : CourseBLL
    participant courseMPP as courseMPP : CourseMPP
    participant dal as dal : AccessDAL
    participant bd as Base de Datos

    Note over Coordinador,bd: CU-13 Crear Inscripción - flujo básico y flujos alternativos

    Coordinador->>frm: Accede al formulario "Gestión de Inscripciones" del menú "Académico"
    frm->>frm: _enrollmentBLL = ServiceLocatorBLL.CreateEnrollmentBLL()
    frm->>frm: _courseBLL = ServiceLocatorBLL.CreateCourseBLL()
    frm->>frm: _studentBLL = ServiceLocatorBLL.CreateStudentBLL()
    frm->>studentBLL: FindAllActive(): List<StudentBE>
    studentBLL->>studentMPP: FindAllActive(): List<StudentBE>
    studentMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de alumnos activos
    bd-->>dal: Filas resultantes
    dal-->>studentMPP: DataTable
    studentMPP-->>studentBLL: List<StudentBE>
    studentBLL-->>frm: List<StudentBE>
    frm->>courseBLL: FindAll(): List<CourseBE>
    courseBLL->>courseMPP: FindAll(): List<CourseBE>
    courseMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de cursos
    bd-->>dal: Filas resultantes
    dal-->>courseMPP: DataTable
    courseMPP-->>courseBLL: List<CourseBE>
    courseBLL-->>frm: List<CourseBE>
    frm->>enrollmentBLL: FindAll(): List<EnrollmentBE>
    enrollmentBLL->>enrollmentMPP: FindAll(): List<EnrollmentBE>
    enrollmentMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
    dal->>bd: Consulta parametrizada de inscripciones
    bd-->>dal: Filas resultantes
    dal-->>enrollmentMPP: DataTable
    enrollmentMPP-->>enrollmentBLL: List<EnrollmentBE>
    enrollmentBLL-->>frm: List<EnrollmentBE>
    frm-->>Coordinador: Muestra las listas de alumnos y cursos, la grilla y el campo de búsqueda

    Coordinador->>frm: Selecciona el campo "Alumno a inscribir"
    Coordinador->>frm: Selecciona el campo "Curso"
    Coordinador->>frm: Presiona el botón "Inscribir alumno"

    alt Alumno no seleccionado
        frm-->>Coordinador: Muestra "Seleccione un alumno para inscribir."
    else Curso no seleccionado
        frm-->>Coordinador: Muestra "Debe seleccionar un curso."
    else Alumno y curso seleccionados
        frm-->>Coordinador: Muestra "¿Desea inscribir a '<alumno>' en el curso '<curso>'?"

        alt El usuario presiona "No"
            frm-->>Coordinador: No realiza ningún cambio y permanece en el formulario
        else El usuario presiona "Sí"
            frm->>enrollmentBLL: Enroll(courseId: int, studentId: int): bool
            enrollmentBLL->>enrollmentMPP: ExistsActiveEnrollment(courseId: int, studentId: int): bool
            enrollmentMPP->>dal: ReadScalar(consulta: string, parameters: SqlParameter[]): int
            dal->>bd: Consulta de inscripción activa
            bd-->>dal: Cantidad de coincidencias
            dal-->>enrollmentMPP: int
            enrollmentMPP-->>enrollmentBLL: false

            alt Alumno ya inscripto en el curso
                enrollmentBLL-->>frm: Rechaza: "Ya está inscripto en este curso."
                frm-->>Coordinador: Muestra "Ya está inscripto en este curso."
            else Sin inscripción previa
                enrollmentBLL->>courseBLL: FindById(courseId: int): CourseBE
                courseBLL->>courseMPP: FindById(courseId: int): CourseBE
                courseMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                dal->>bd: Consulta parametrizada del curso
                bd-->>dal: Filas resultantes
                dal-->>courseMPP: DataTable
                courseMPP-->>courseBLL: CourseBE
                courseBLL-->>enrollmentBLL: CourseBE

                alt Curso inexistente o inactivo
                    enrollmentBLL-->>frm: Rechaza: "El curso seleccionado no existe."
                    frm-->>Coordinador: Muestra "El curso seleccionado no existe."
                else Curso sin horario definido
                    enrollmentBLL-->>frm: Rechaza: "El curso seleccionado no tiene horario definido."
                    frm-->>Coordinador: Muestra "El curso seleccionado no tiene horario definido."
                else Curso con horario definido
                    enrollmentBLL->>enrollmentMPP: FindByStudentId(studentId: int): List<EnrollmentBE>
                    enrollmentMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                    dal->>bd: Consulta parametrizada de inscripciones del alumno
                    bd-->>dal: Filas resultantes
                    dal-->>enrollmentMPP: DataTable
                    enrollmentMPP-->>enrollmentBLL: List<EnrollmentBE>
                    enrollmentBLL->>enrollmentMPP: ExistsScheduleOverlap(studentId: int, dayOfWeek: int, startTime: TimeSpan, endTime: TimeSpan, courseIdToExclude: int): bool
                    enrollmentMPP->>dal: ReadScalar(consulta: string, parameters: SqlParameter[]): int
                    dal->>bd: Consulta de traslape de horario
                    bd-->>dal: Cantidad de coincidencias
                    dal-->>enrollmentMPP: int
                    enrollmentMPP-->>enrollmentBLL: false

                    alt Traslape de horario con otra inscripción vigente
                        enrollmentBLL-->>frm: Rechaza: "Tiene traslape de horario con el curso '<curso>' (<día> <hora inicio> - <hora fin>)."
                        frm-->>Coordinador: Muestra "Tiene traslape de horario con el curso '<curso>' (<día> <hora inicio> - <hora fin>)."
                    else Sin traslape
                        enrollmentBLL->>enrollmentMPP: Enroll(courseId: int, studentId: int): bool
                        enrollmentMPP->>dal: Save(operacion: string, parameters: SqlParameter[]): bool
                        dal->>bd: Registro de la inscripción
                        bd-->>dal: 1 fila afectada
                        dal-->>enrollmentMPP: true
                        enrollmentMPP-->>enrollmentBLL: true
                        enrollmentBLL-->>frm: true

                        frm->>enrollmentBLL: FindAll(): List<EnrollmentBE>
                        enrollmentBLL->>enrollmentMPP: FindAll(): List<EnrollmentBE>
                        enrollmentMPP->>dal: Read(consulta: string, parameters: SqlParameter[]): DataTable
                        dal->>bd: Consulta parametrizada de inscripciones
                        bd-->>dal: Filas resultantes
                        dal-->>enrollmentMPP: DataTable
                        enrollmentMPP-->>enrollmentBLL: List<EnrollmentBE>
                        enrollmentBLL-->>frm: List<EnrollmentBE>
                        frm-->>Coordinador: Muestra "Inscripción realizada exitosamente." y actualiza la grilla
                    end
                end
            end
        end
    end
